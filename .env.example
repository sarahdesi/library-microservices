# Copie para .env (na raiz) e defina seus valores. O .env nao vai para o git.
# Usado pelo docker compose.

MARIADB_ROOT_PASSWORD=troque-esta-senha

# Chave do JWT, compartilhada entre user-service e api-gateway (minimo 32 caracteres)
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres

# Bibliotecaria inicial: criada so se ainda nao existir nenhuma (senha com 8+ caracteres)
LIBRARIAN_EMAIL=bibliotecaria@exemplo.com
LIBRARIAN_PASSWORD=troque-esta-senha
